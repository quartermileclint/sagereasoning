# SageReasoning website — example environment file (complete census)
#
# Rewritten 2026-06-10 at the Pre-Launch S7b close (review rec 1.4,
# D-MULTIDISCIPLINARY-REVIEW-2026-06-10): this file now documents EVERY
# environment variable the code reads (sweep: `grep -rhoE
# "process\.env\.[A-Z0-9_]+" src/ scripts/`), as disaster-recovery
# documentation for a solo founder. If the Vercel environment were ever lost,
# this file is the checklist for rebuilding it.
# (Prior version — A1-era, 6 vars — preserved in git history.)
#
# RULES OF THIS FILE
# - Real secret VALUES are never committed here. Secrets appear as names with
#   a generation hint. Real values live only in /website/.env.local
#   (gitignored) and the Vercel project settings.
# - Defaults shown are the SAFE defaults (flags false/unset = inert). The
#   CURRENT production disposition of each flag is tracked in /CLAUDE.md
#   ("Production state" block) and the decision log — not here. This file
#   says what each variable is, not what it is set to today.
# - Convention: copy to /website/.env.local and fill in. Never commit .env.local.
#
# =============================================================================
# 1. CORE PLATFORM CONNECTIONS (required for the site to run at all)
# =============================================================================

# Supabase project URL (production ref jdbefwkonfbhjquozgxr). Public.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anonymous key. Public by design (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET — bypasses RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key. SECRET — every LLM call (scoring, mentor, substrate,
# R20a classifier) is billed against it.
ANTHROPIC_API_KEY=

# OpenAI API key. SECRET — used only by the RAG passage-retrieval embedding
# path (src/lib/rag/retrieve-passages.ts).
OPENAI_API_KEY=

# Canonical site URL used for generated links (badges etc.).
NEXT_PUBLIC_SITE_URL=https://www.sagereasoning.com

# =============================================================================
# 2. IDENTITY / ADMIN GATES
# =============================================================================

# Clinton's auth user id — gates /admin and admin API routes (requireAdmin).
ADMIN_USER_ID=

# Founder's auth user id — gates founder-stream routes (/api/founder/hub,
# founder mentor history, ring-proof).
FOUNDER_USER_ID=

# =============================================================================
# 3. ENCRYPTION (R17b)
# =============================================================================

# AES-256-GCM key for server-side intimate-data encryption (mentor profile
# stores, journal prose, reflect sessions). SECRET. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: no rotation mechanism yet (version field exists; rotation
# unimplemented — known limitation, logged 2026-06-10 review §3.4).
MENTOR_ENCRYPTION_KEY=

# =============================================================================
# 4. R20a SAFETY PERIMETER FLAGS (PR6 — any change to these is Critical)
# =============================================================================
# All four are 'true' in production since 2026-05-31 (verified S6). Safe
# default in a fresh environment is unset (inert) — but a production rebuild
# MUST set all four true before exposing any human-facing LLM surface.

# Distress detection + redirect on the calling surface.
SUBSTRATE_CALLING_R20A_ENABLED=false

# Distress detection + redirect on the reflect surface.
SUBSTRATE_REFLECT_R20A_ENABLED=false

# Audience-correct rendering (human → crisis message; agent → developer-form
# payload).
SUBSTRATE_R20A_AUDIENCE_RENDERING_ENABLED=false

# Server-side Zone-2 gate on /api/reason.
SUBSTRATE_R20A_GATE_ENABLED=false

# R20b framework-dependence coaching (OFF-perimeter; inert by decision).
R20B_INDEPENDENCE_COACHING_ENABLED=false

# =============================================================================
# 5. SUBSTRATE / PRODUCT FEATURE FLAGS
# =============================================================================

# The Calling practice surface (/api/calling).
SAGE_CALLING_ENABLED=false

# The Reflect practice surface (/api/practice/reflect).
SAGE_REFLECT_ENABLED=false

# Accreditation write path (/api/accreditation/[agent_id]).
SUBSTRATE_WRITE_PATH_ENABLED=false

# Standalone Layer 3 per-consumer rendering (/api/substrate/layer3).
# Decided OUT of launch scope at S7 (2026-06-09) — stays unset (route → 503).
SUBSTRATE_LAYER3_ENABLED=false

# A12 OpenTelemetry + call-grain audit writes to substrate_audit_events.
SUBSTRATE_OTEL_ENABLED=false

# A11b Layer-1 prompt-injection defence (Critical; the R20a signal is computed
# on RAW input BEFORE Layer 1, so this cannot suppress distress detection).
SUBSTRATE_INJECTION_DEFENCE_ENABLED=false

# Translation-sandwich parallel-run comparison logging.
TRANSLATION_SANDWICH_PARALLEL_RUN=false

# Mentor context architecture v2 toggle (founder hub + private reflect).
MENTOR_CONTEXT_V2=false

# =============================================================================
# 6. PLUGIN AUTH (Layer 2 / A10)
# =============================================================================

# Legacy shared-secret plugin auth scaffold (X-Plugin-Auth header).
PLUGIN_AUTH_ENABLED=false
# Companion SECRET for the above (constant-time compared). Generate:
#   openssl rand -hex 32
PLUGIN_AUTH_SECRET=

# A10 per-install plugin auth (sr_inst_ Bearer tokens; api_keys rows;
# instant revocation via is_active). Live in production since S5 (2026-06-09).
PLUGIN_INSTALL_AUTH_ENABLED=false

# =============================================================================
# 7. LAYER 2 SIGNING (Ed25519; /api/public-key)
# =============================================================================

# Enables Layer-2 payload signing (audit writer + parallel-run).
SUBSTRATE_LAYER2_SIGNING_ENABLED=false

# Current key metadata served by /api/public-key.
SUBSTRATE_LAYER2_KEY_ID=substrate-layer2-2026Q2
SUBSTRATE_LAYER2_KEY_ISSUED_AT=
SUBSTRATE_LAYER2_PUBLIC_KEY=

# Rotation-overlap variables — set ONLY during a key rotation window; unset in
# steady state (then /api/public-key serves previous: null).
SUBSTRATE_LAYER2_PREVIOUS_KEY_ID=
SUBSTRATE_LAYER2_PREVIOUS_KEY_ISSUED_AT=
SUBSTRATE_LAYER2_PREVIOUS_KEY_RETIRES_AT=
SUBSTRATE_LAYER2_PREVIOUS_PUBLIC_KEY=

# =============================================================================
# 8. OBSERVABILITY (A13 cost-health, A19 abuse, S7b cron delivery, A14 SLO)
# =============================================================================

# A13 cost-health evaluator (/api/billing/cost-alerts/evaluate).
SUBSTRATE_COST_ALERTS_ENABLED=false
# Service token for the cost evaluator (x-cost-alerts-token header). SECRET.
#   openssl rand -hex 32
COST_ALERTS_EVAL_TOKEN=

# A19 abuse detection (/api/abuse/evaluate; request_velocity_anomaly).
SUBSTRATE_ABUSE_DETECTION_ENABLED=false
# A19 structural detectors rollout (systematic_enumeration +
# rapid_input_variation).
SUBSTRATE_ABUSE_DETECTION_ROLLOUT_ENABLED=false
# Service token for the abuse evaluator (x-abuse-detection-token). SECRET.
ABUSE_DETECTION_EVAL_TOKEN=

# S7b daily observability cron (/api/cron/observability, vercel.json
# schedule 0 8 * * *). Vercel sends this SECRET automatically as
# `Authorization: Bearer <CRON_SECRET>`. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Incoming-webhook URL the cron posts alerts to (Slack or Discord). SECRET
# (anyone holding it can post to the channel).
ALERT_WEBHOOK_URL=

# Base URL for the cron's self-calls to the two evaluators. REQUIRED in
# production: must be the custom domain, because Vercel Deployment Protection
# (Standard) walls the *.vercel.app URL that VERCEL_URL resolves to — self-
# calls via VERCEL_URL get 401 from Vercel's auth wall, not the evaluator.
# (Root-caused at S7b, 2026-06-10.)
CRON_SELF_BASE_URL=https://www.sagereasoning.com

# A14 read-only SLO/health tracker (/api/admin/slo-health; founder-admin
# gated via ADMIN_USER_ID; Bearer-JWT only — browser page-visits 401).
SUBSTRATE_SLO_TRACKER_ENABLED=false

# =============================================================================
# 9. STRIPE (Option D loop billing — not_configured in production by decision;
#    launch-criterion tension recorded for P1)
# =============================================================================

# SECRET — Stripe API key.
STRIPE_SECRET_KEY=
# SECRET — Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Public — Stripe publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (config, not secret).
STRIPE_PER_LOOP_PRICE_ID=
STRIPE_DEVELOPER_PRICE_ID=
STRIPE_TIDING_MONTHLY_PRICE_ID=
STRIPE_TIDING_ONCEOFF_PRICE_ID=

# =============================================================================
# 10. TEST HARNESS ONLY (scripts/ — never needed in Vercel)
# =============================================================================

# Whole-system harness (scripts/whole-system-harness/*) target + credentials.
WSH_BASE_URL=
WSH_API_KEY=
WSH_AGENT_ID=
WSH_ASSENT_TOKEN=

# Translation-sandwich verification script knobs (scripts/).
LAYER1_REPLAY_CACHE=
LAYER3_FORCE_REGEN=
TRANSLATION_SANDWICH_TIER1_SECRET=

# =============================================================================
# 11. PLATFORM-PROVIDED (set by Vercel/Next.js automatically — do NOT set)
# =============================================================================
# VERCEL_URL     — the deployment's *.vercel.app host (see CRON_SELF_BASE_URL
#                  note above for why self-calls must not rely on it).
# NEXT_RUNTIME   — Next.js runtime identifier.
