# SageReasoning website — example environment file
#
# Created 2026-05-10 in the Stage 1 kickoff session of the substrate-as-plugin
# build arc. Companion to /adopted/ADR-stoic-agent-substrate-concept.md and
# /adopted/substrate-plugin-staging-plan.md Stage 1 item A1.
#
# This file documents non-secret environment variables that the website
# expects. Real secrets (API keys, signing secrets, encryption keys) are NOT
# committed to this file — they live in /website/.env.local (gitignored) and
# in the Vercel project settings. This file exists only to document which
# variables exist and what their default values are.
#
# Convention: copy this file to /website/.env.local and replace placeholder
# values. Never commit /website/.env.local.

# =============================================================================
# A1 — Stage 1 Layer 2 plugin-auth feature flag (PR1 single-endpoint proof)
# =============================================================================
#
# When set to 'true' in the deployment environment, the /api/reason route's
# plugin-auth scaffold (function checkPluginAuth, defined in that route) MAY
# authenticate plugin-originated calls via the X-Plugin-Auth header. The
# scaffold is currently defined but NOT INVOKED — flipping this flag to 'true'
# alone has no effect; an invocation site must also be wired in (which is
# scheduled for a subsequent session per PR1 single-endpoint proof discipline).
#
# Default: 'false' (or unset; treated as false). Keep this at 'false' until the
# Critical Change Protocol's deploy-phase review is complete and an explicit
# founder approval for the flag-flip has been recorded in the decision log.
#
# Per: /adopted/ADR-stoic-agent-substrate-concept.md
#      /adopted/substrate-plugin-staging-plan.md (Stage 1 item A1)
#      D-A1-LAYER2-AUTH-SCAFFOLD-2026-05-10
PLUGIN_AUTH_ENABLED=false

# Companion secret (only relevant when PLUGIN_AUTH_ENABLED=true). When the
# flag is on AND an invocation site exists in /api/reason, the plugin-auth
# function performs a constant-time comparison of the X-Plugin-Auth header
# against this value. Generate via a cryptographically-strong source
# (e.g., `openssl rand -hex 32`) and store the real value only in
# /website/.env.local and Vercel project settings. Never commit the real
# secret. With the flag at 'false' (the current scaffold posture), this
# variable is unused.
PLUGIN_AUTH_SECRET=
