node_modules/
.next/
out/

# Build outputs
dist/
build/

# Stoic Brain internal data — full scoring weights and formulas (proprietary)
# These files are used server-side and for enterprise licences only.
# Never commit to public repository.
stoic-brain/internal/

# Agent Assessment internal data — output schemas, test frameworks, proprietary weights
# These files are used server-side for scoring and internal testing only.
# Never commit to public repository.
agent-assessment/internal/

# Perseus Digital Library source files — non-commercial license, not for redistribution
