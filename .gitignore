# Environment variables — NEVER commit these
.env
.env.local
.env.production

# macOS
.DS_Store
.DS_Store?
._*

# FUSE mount shadow files — transient host-side copies created when the workspace
# edits a file the host holds open. Never commit.
.fuse_hidden*

# Node.js (for website phase)
node_modules/
.next/
out/

# Build outputs
dist/
build/

# Stoic Brain internal data — full scoring weights and formulas (proprietary)
# These files are used server-side and for enterprise licences only.
# Never commit to public repository.
stoic-brain/internal/

# Agent Assessment internal data — output schemas, test frameworks, proprietary weights
# These files are used server-side for scoring and internal testing only.
# Never commit to public repository.
agent-assessment/internal/

# Perseus Digital Library source files — non-commercial license, not for redistribution
# SR translations in /research/originals/translations/ are SageReasoning original work and ARE safe to commit.
research/originals/greek/
research/originals/latin/
research/originals/manuscripts/

# Private journal data — founder's personal practice, NEVER commit
journal/private/

# Translation-sandwich harness cache — Layer 1 schema replay for Phase 3+4
# Per ADR-006 §4 idempotency verification approach. Local-only; not committed.
website/scripts/.translation-sandwich-cache/

# IDE
.vscode/
.idea/

# Local env-file backups (may contain secrets) — never commit
.env.local.*
website/tsconfig.tsbuildinfo
