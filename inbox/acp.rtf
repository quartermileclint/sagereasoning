\f0\b\fs64 \AppleTypeServices\AppleTypeServicesF65539 \cf2 \strokec2 \
\pard\pardeftab720\partightenfactor0
\cf2 Security and privacy notes\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls11\ilvl0
\f1\b0\fs24 \AppleTypeServices \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec5 Sellers MUST NOT use agent-declared capabilities as the sole basis for security decisions; they MUST enforce authentication and payment rules server-side.\
\ls11\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec5 Sellers SHOULD advertise only capabilities relevant to the current session and avoid exposing unnecessary internal detail.\
\ls11\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec5 Agents SHOULD declare only capabilities needed for checkout and avoid declaring more than necessary (e.g., for fingerprinting).\
\pard\pardeftab720\partightenfactor0

